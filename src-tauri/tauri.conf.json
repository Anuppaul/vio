{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VIO",
  "version": "1.0.0",
  "identifier": "com.anuppaul.vio",
  "build": {
    "frontendDist": "../out",
    "beforeBuildCommand": "npm run build:desktop:web",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VIO — Violin Practice",
        "width": 1100,
        "height": 780,
        "minWidth": 680,
        "minHeight": 520,
        "backgroundColor": "#f8f9fd"
      }
    ],
    "security": {
      "csp": "default-src 'self' blob: data:; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "nsis"
    ],
    "shortDescription": "Violin practice toolkit",
    "category": "Music",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
