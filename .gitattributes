# Preserve consistent text formatting across platforms.
* text=auto
*.sh text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.java text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.svg text eol=lf
*.md text eol=lf

# Media, icons and APK archives are binary.
*.mp3 binary
*.wav binary
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.webp binary
*.apk binary
*.aab binary
*.keystore binary
*.jks binary
