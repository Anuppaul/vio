{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VIO",
  "version": "1.0.0",
  "identifier": "com.anuppaul.vio",
  "build": {
    "frontendDist": "../out",
    "beforeBuildCommand": "npm run build:desktop:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VIO — Violin Practice",
        "width": 1100,
        "height": 780,
        "minWidth": 680,
        "minHeight": 520,
        "backgroundColor": "#f8f9fd"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "nsis"
    ],
    "shortDescription": "Violin practice toolkit",
    "category": "Music",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
